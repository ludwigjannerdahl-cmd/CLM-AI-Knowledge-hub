{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/clm/specimen.schema.json",
  "title": "CLM task specimen adapter contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "publication",
    "provenance",
    "task",
    "facts",
    "envelope",
    "objects",
    "bindingContext",
    "supportAssertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "enum": [
        "safe-synthetic",
        "private-internal"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin",
        "privateDerived"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "privateDerived": {
          "type": "boolean"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "work",
        "businessScope",
        "partyType",
        "jurisdiction",
        "stage",
        "purpose",
        "inputs",
        "requiredKnowledge",
        "method",
        "outputContract",
        "stopConditions",
        "humanDecisionRights",
        "writeAuthority",
        "evidenceRequirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "work": {
          "type": "string",
          "minLength": 1
        },
        "businessScope": {
          "type": "string",
          "minLength": 1
        },
        "partyType": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredKnowledge": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "outputContract": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stopConditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "humanDecisionRights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writeAuthority": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRequirement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "number",
          "null"
        ]
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "status",
        "desired",
        "runtime",
        "modelVersion",
        "knowledgePackageVersion",
        "identity",
        "logging",
        "disable",
        "write",
        "verificationEvidence",
        "capabilities"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "verified",
            "not-verified"
          ]
        },
        "desired": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgePackageVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "logging": {
          "type": [
            "string",
            "null"
          ]
        },
        "disable": {
          "type": [
            "string",
            "null"
          ]
        },
        "verificationEvidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "write": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "available",
              "verified",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "available": {
                "type": "boolean"
              },
              "verified": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "bindingContext": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supportAssertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence",
          "target",
          "version",
          "state"
        ],
        "properties": {
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "title",
        "family",
        "kind",
        "subject",
        "assertion",
        "scope",
        "authority_for",
        "not_authority_for",
        "supportingEvidence",
        "version",
        "status",
        "revalidate_when"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "source",
            "meaning",
            "implementation",
            "work",
            "assurance"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "boolean",
                "number"
              ]
            }
          }
        },
        "authority_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_authority_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supportingEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revalidate_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtimeEligible": {
          "type": "boolean"
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "target"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
